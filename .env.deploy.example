# Copy to .env.deploy and replace placeholder values before deployment.

# Corvus API v1 (story generation).
CORVUS_API_BASE_URL=https://api-corvus.foxluma.com/v1
# Host file holding only the FoxWords Corvus key (mode 0600, outside Git).
CORVUS_API_KEY_HOST_FILE=/home/ethan/srv/secrets/foxwords/corvus_api_key
CORVUS_TIMEOUT_MS=100000
# Local budget across all FoxWords AI features (Corvus allows 6/min globally).
CORVUS_MAX_PER_MINUTE=4
STORY_LIMIT=10

# Optional legacy local model, only with `docker compose --profile local-llm`.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA_MODEL_FILE=your-model-file.gguf
LLAMA_MODEL=foxwords
LLAMA_GPU_LAYERS=99
LLAMA_CONTEXT_SIZE=4096
LLAMA_PARALLEL=1
